# Frontend build-time variables (Create React App inlines REACT_APP_* at build time).
# Copy to frontend/.env for local builds, or set them in the Cloudflare Pages build settings.
# Names only; never commit real values.

# HTTPS origin of the backend API, no trailing slash.
REACT_APP_BACKEND_URL=

# Waitlist-only build (EMP-WL-002): "true" serves only /, /privacy and /terms and leaves the
# dashboard/admin/auth code out of the bundle. Pair with backend WAITLIST_ONLY=true.
# See docs/deploy/waitlist-only.md.
REACT_APP_WAITLIST_ONLY=

# Site metadata (EMP-WL-014), read at build time by frontend/site-meta.js.
# TODO(Brann): brand name, description, domain and share image are Brann's call.
# Unset name/description keep the current title/description. Without REACT_APP_SITE_URL no
# sitemap.xml is built and robots.txt has no Sitemap line; without REACT_APP_OG_IMAGE_URL no
# og:image/twitter:image is emitted. Both URLs must be absolute https URLs (the build fails otherwise).
REACT_APP_SITE_NAME=
REACT_APP_SITE_DESCRIPTION=
REACT_APP_SITE_URL=
REACT_APP_OG_IMAGE_URL=
