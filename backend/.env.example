# Copy this file to backend/.env and provide your own secrets. Never commit .env.
# Core backend and database
APP_ENV=
MONGO_URL=mongodb://mongo:27017
DB_NAME=ai_office
# Optional (EMP-WL-061): waitlist signup DB deadline in ms; default 5000
WAITLIST_DB_TIMEOUT_MS=
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Comma-separated exact browser origins allowed to call the API with credentials
# (scheme://host[:port], no paths or wildcards; https in production/staging).
# e.g. the Cloudflare Pages URL and the custom domain apex + www each need their own entry.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Admin provisioning: set values privately before starting production.
# Platform admin email (no default). If empty, no platform admin is seeded.
ADMIN_EMAIL=
# Initial admin password: used ONLY on first seed; must be 12+ chars with upper, lower, digit, symbol.
# Admin must change it at first login. Leave empty to seed an unusable password + use forgot-password.
ADMIN_PASSWORD=

# Choose one AI provider.
EMERGENT_LLM_KEY=
OPENAI_API_KEY=
# Free option: Google AI Studio key (https://aistudio.google.com/apikey) — no card needed.
# Used by llm_portable fallback (after OpenAI) and preferred for vision/photo estimates.
GEMINI_API_KEY=

# Knowledge embeddings (OFF by default — set only after Brann approves provider/spend).
# EMBEDDINGS_PROVIDER=openai   # or: off | fake (tests) | openai
# EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=

# Choose one email provider.
EMERGENT_EMAIL_KEY=
RESEND_API_KEY=

# Payments: configure test-mode keys before Stripe verification.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Scheduled tasks
WEBHOOK_CRON_SECRET=

# Optional telephony and OAuth
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# /api/twilio/* webhooks need a valid X-Twilio-Signature (tenant auth token, else TWILIO_AUTH_TOKEN).
# PUBLIC_BACKEND_URL = the public origin entered in the Twilio console, e.g. https://api.example.com.
# Required unless APP_ENV=development; with no token at all, webhooks are refused outside development.
PUBLIC_BACKEND_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Waitlist-only deploy: when true, only /api/health and POST /api/public/waitlist are served
# (no docs, auth, admin, cron or webhooks; no startup seeding). Default off.
# Deploy it only after PR #11 is merged. Also set CORS_ORIGINS (above) to the exact Pages/custom-domain
# origins, including the page's own origin if the API is served from the same origin (the waitlist
# Origin check uses the same list), APP_ENV=production, and FORWARDED_ALLOW_IPS (from #11) to the
# proxy's IP. See docs/deploy/waitlist-only.md.
WAITLIST_ONLY=
# development (default) | staging | production. With PR #10, staging/production need explicit https
# CORS_ORIGINS; if it's missing the server still starts but fails closed (no cross-origin access).
APP_ENV=

# Client IP behind proxies: comma-separated exact IPs whose X-Forwarded-For is trusted.
# Empty = 127.0.0.1. Under docker-compose this is set from AIO_COMPOSE_GATEWAY (default 172.30.0.1)
# and must equal the compose network gateway. Never '*'.
# Cloudflare's ranges go in Nginx set_real_ip_from, not here (docs/deploy/client-ip-and-proxies.md).
FORWARDED_ALLOW_IPS=

# Waitlist bot check (Cloudflare Turnstile). Off unless TURNSTILE_ENABLED=true.
# Frontend build needs REACT_APP_TURNSTILE_ENABLED=true and REACT_APP_TURNSTILE_SITE_KEY (the build
# fails if enabled without a key). Turn it on/off on BOTH sides together.
# TURNSTILE_ENABLED=true without TURNSTILE_SECRET_KEY stops the backend at startup.
TURNSTILE_ENABLED=
TURNSTILE_SECRET_KEY=

# Waitlist confirmation email (EMP-WL-008). Off unless WAITLIST_CONFIRMATION_EMAIL=true.
# Off = no email at all; the page shows the success message only.
WAITLIST_CONFIRMATION_EMAIL=

# Uvicorn worker count. Keep 1: waitlist/demo rate limits are per process (EMP-WL-021).
WEB_CONCURRENCY=

# Public landing WebRTC voice demo (OFF by default — Brann must approve spend).
# PUBLIC_VOICE_DEMO_ENABLED=true
# PUBLIC_VOICE_DEMO_MODEL=gpt-realtime
# PUBLIC_VOICE_DEMO_VOICE=alloy
# PUBLIC_VOICE_DEMO_MAX_SECONDS=60
PUBLIC_VOICE_DEMO_ENABLED=
PUBLIC_VOICE_DEMO_MODEL=
PUBLIC_VOICE_DEMO_VOICE=
PUBLIC_VOICE_DEMO_MAX_SECONDS=

# Public brand in emails/invoices (on hold until the DBA is registered; placeholders). Keep in sync with frontend REACT_APP_BRAND_*.
BRAND_NAME=Your Business Name
BRAND_SLOGAN=Your slogan here
# Public contact address (outbound User-Agent) and site URL (waitlist email link). Placeholders; no real domain in code.
CONTACT_EMAIL=contact@example.com
SITE_URL=

# ---- Security hardening (2026-10-15) ----
# Two-factor (TOTP) secret encryption. Fernet key; generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Falls back to BOOKKEEPING_LINK_ENCRYPTION_KEY if unset. 2FA setup fails closed
# (503) when neither is set.
TWO_FACTOR_ENCRYPTION_KEY=
# Distributed rate limiting. When set, login/2FA rate limits are enforced in
# Redis (shared across workers); otherwise per-process in-memory fallback.
REDIS_URL=
# Error monitoring (Sentry). Backend + frontend both no-op unless set.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Frontend: REACT_APP_SENTRY_DSN mirrors SENTRY_DSN for the browser bundle.
# REACT_APP_SENTRY_DSN=
