# Copy this file to backend/.env and provide your own secrets. Never commit .env.
# Core backend and database
MONGO_URL=mongodb://mongo:27017
DB_NAME=ai_office
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Admin provisioning: set values privately before starting production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Choose one AI provider.
EMERGENT_LLM_KEY=
OPENAI_API_KEY=

# Choose one email provider.
EMERGENT_EMAIL_KEY=
RESEND_API_KEY=

# Payments: configure test-mode keys before Stripe verification.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Scheduled tasks
WEBHOOK_CRON_SECRET=

# Optional telephony and OAuth
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Public landing WebRTC voice demo (OFF by default — Brann must approve spend).
# PUBLIC_VOICE_DEMO_ENABLED=true
# PUBLIC_VOICE_DEMO_MODEL=gpt-realtime
# PUBLIC_VOICE_DEMO_VOICE=alloy
# PUBLIC_VOICE_DEMO_MAX_SECONDS=60
PUBLIC_VOICE_DEMO_ENABLED=
PUBLIC_VOICE_DEMO_MODEL=
PUBLIC_VOICE_DEMO_VOICE=
PUBLIC_VOICE_DEMO_MAX_SECONDS=
