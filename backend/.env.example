# Copy this file to backend/.env and provide your own secrets. Never commit .env.
# Core backend and database
MONGO_URL=mongodb://mongo:27017
DB_NAME=ai_office
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
# Comma-separated exact browser origins allowed to call the API with credentials
# (scheme://host[:port], no paths or wildcards; https in production/staging).
# e.g. the Cloudflare Pages URL and the custom domain apex + www each need their own entry.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Admin provisioning: set values privately before starting production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Choose one AI provider.
EMERGENT_LLM_KEY=
OPENAI_API_KEY=

# Choose one email provider.
EMERGENT_EMAIL_KEY=
RESEND_API_KEY=

# Payments: configure test-mode keys before Stripe verification.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Scheduled tasks
WEBHOOK_CRON_SECRET=

# Optional telephony and OAuth
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Client IP behind proxies: comma-separated exact IPs whose X-Forwarded-For is trusted.
# Empty = 127.0.0.1. docker-compose with host Nginx/cloudflared: 172.30.0.1. Never '*'.
# Cloudflare's ranges go in Nginx set_real_ip_from, not here (docs/deploy/client-ip-and-proxies.md).
FORWARDED_ALLOW_IPS=

# Waitlist bot check (Cloudflare Turnstile). Off unless TURNSTILE_ENABLED=true.
# Frontend build needs REACT_APP_TURNSTILE_SITE_KEY to show the widget.
TURNSTILE_ENABLED=
TURNSTILE_SECRET_KEY=
