# Copy this file to backend/.env and provide your own secrets. Never commit .env.
# Core backend and database
MONGO_URL=mongodb://mongo:27017
DB_NAME=ai_office
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Admin provisioning: set values privately before starting production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Choose one AI provider.
EMERGENT_LLM_KEY=
OPENAI_API_KEY=

# Choose one email provider.
EMERGENT_EMAIL_KEY=
RESEND_API_KEY=

# Payments: configure test-mode keys before Stripe verification.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=

# Scheduled tasks
WEBHOOK_CRON_SECRET=

# Optional telephony and OAuth
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Waitlist-only deploy: when true, only /api/health and POST /api/public/waitlist are served
# (no docs, auth, admin, cron or webhooks; no startup seeding). Default off.
# For that deploy also set CORS_ORIGINS (above) to the exact Pages/custom-domain origins, or the
# browser form can't reach the API, and APP_ENV=production. See docs/deploy/waitlist-only.md.
WAITLIST_ONLY=
# development (default) | staging | production. staging/production require explicit https
# CORS_ORIGINS (PR #10 enforces this at startup).
APP_ENV=
